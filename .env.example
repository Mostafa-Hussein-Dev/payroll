# PostgreSQL connection string used at runtime.
# Local dev: a direct localhost connection.
# Production (Supabase): use the POOLED connection (port 6543) + ?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/payroll?schema=public"

# Direct (non-pooled) connection used ONLY for migrations (prisma migrate/db push).
# Local dev: same as DATABASE_URL.
# Production (Supabase): the DIRECT connection (port 5432).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/payroll?schema=public"

# Secret used to sign login session cookies (change to a long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# Seed admin credentials (used by `npm run db:seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin1234"
